{
    "display_information": {
        "name": "Slacky Dev"
    },
    "features": {
        "bot_user": {
            "display_name": "Slacky Dev",
            "always_online": false
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "https://localhost:8080/auth/callback"
        ],
        "scopes": {
            "bot": [
                "channels:history",
                "channels:read",
                "chat:write",
                "groups:history",
                "im:history",
                "im:read",
                "mpim:history",
                "mpim:read",
                "users:read"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "message.channels",
                "message.groups",
                "message.im",
                "message.mpim"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false
    }
}